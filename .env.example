APP_NAME=Vaytoven
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.vaytoven.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Production logs to Laravel Cloud's socket as structured JSON.
# Local dev typically uses `single` to a file; uncomment locally.
LOG_CHANNEL=laravel-cloud-socket
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

# MySQL 8.4 on Laravel Cloud. Local dev: docker compose up mysql.
# (See docs/architecture.md for why MySQL not Postgres.)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vaytoven
DB_USERNAME=root
DB_PASSWORD=

# Session, queue, and cache all sit on Redis in production. The previous
# file-based defaults break under horizontal scaling: each container has its
# own filesystem, so sessions and locks would diverge across replicas.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SCHEDULE_CACHE_DRIVER=redis

# Redis connection. In production, Laravel Cloud injects REDIS_HOST/PORT/PASSWORD
# automatically when a Cache resource is attached. Locally, run `docker compose up redis`.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_CACHE_DB=0
REDIS_PERSISTENT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@vaytoven.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# DocuSign eSignature API (JWT Grant flow + Connect webhooks)
# Set the *-d / demo URLs for sandbox; switch to account.docusign.com /
# www.docusign.net for production.
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
DOCUSIGN_API_BASE=https://demo.docusign.net
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Either paste the full PEM (escape newlines as literal \n in .env) or set the path:
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_PATH=
# Pipe-separated HMAC keys from Connect (e.g. KEY1|KEY2 — up to 10 during rotation)
DOCUSIGN_HMAC_KEYS=

# NMI payment gateway (replaced Stripe, 2026-07). security_key = private
# Payment API key; tokenization_key = public Collect.js key; signing key
# comes from the merchant portal when the webhook endpoint is registered.
# All unset = demo mode (bookings hold at pending_payment, no gateway calls).
NMI_SECURITY_KEY=
NMI_TOKENIZATION_KEY=
NMI_WEBHOOK_SIGNING_KEY=

# Anthropic — AI Support Chat (Phase 7)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# MaxMind GeoIP2 — IP geolocation for tracking + login security (Phase 9)
# Mount the .mmdb files via the deploy filesystem and point here. Both unset
# = NoOpGeoIpService (graceful degradation; no anomaly detection).
MAXMIND_MMDB_PATH=
MAXMIND_ANONYMOUS_MMDB_PATH=
# Reserved for future GeoIP2 web service / ipinfo fallback (not wired yet):
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
IPINFO_TOKEN=

# Mapbox — dashboard map tiles. If unset, the host/member dashboards fall
# back to raw OpenStreetMap tiles. Get a free token at
# https://account.mapbox.com/access-tokens/
MAPBOX_API=
MAPBOX_STYLE=mapbox/light-v11

# Ops Slack webhook — fires on member enquiries (Phase 4). Unset = NoOpSlackNotifier
# so dev/CI run cleanly. Set to a Slack incoming-webhook URL in prod.
SLACK_OPS_WEBHOOK_URL=

# Help center — Meilisearch swap-in for HelpArticleSearch (future, not wired today;
# DatabaseHelpArticleSearch handles search until catalogue grows).
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Per-processor chargeback rebuttal portals (Phase 12). Each adapter has a
# sane default; override here only if you need to point ops to a sandbox/staging
# portal in non-production envs.
CHARGEBACK_PORTAL_AUTHORIZENET=
CHARGEBACK_PORTAL_NMI=
CHARGEBACK_PORTAL_NUVEI=
CHARGEBACK_PORTAL_MES=
CHARGEBACK_PORTAL_PAYMENTCLOUD=
CHARGEBACK_PORTAL_EMS=
CHARGEBACK_PORTAL_NEXIO=
CHARGEBACK_PORTAL_NETEVIA=
CHARGEBACK_PORTAL_KURV=

# Reserved for future per-processor API submission credentials. None of these
# are consumed by code today — NMI is the live gateway (see NMI_* above)
# and the others use the portal-PDF dispute path. Add when sandbox creds for each processor are provisioned.
AUTHORIZENET_LOGIN=
AUTHORIZENET_TRANSACTION_KEY=
AUTHORIZENET_WEBHOOK_SIGNATURE=
NUVEI_MERCHANT_ID=
NUVEI_SECRET_KEY=
